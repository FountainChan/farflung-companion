---
/** Privacy — noindex. */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Privacy · Farflung Clues';
const description = 'Privacy practices of the Farflung Clues companion site.';
---

<BaseLayout title={title} description={description} path="/privacy/" robots="noindex, follow">
  <section class="hero">
    <h1>Privacy</h1>
    <p class="lede">Short version: we do not offer accounts or run site analytics. The homepage displays third-party advertising.</p>
  </section>
  <section class="block">
    <ul>
      <li><strong>Advertising.</strong> The homepage loads an ad script from bauval.org. The ad provider may receive your IP address and browser information when the script loads, and may use cookies or similar technologies subject to its own privacy practices.</li>
      <li><strong>Local countdowns.</strong> The reset countdown runs in your browser using your device clock; nothing is sent anywhere.</li>
      <li><strong>Hosting.</strong> Static files are served by our hosting provider, whose standard access logs apply to all websites.</li>
    </ul>
    <p>Questions? Open an issue on the site’s public repository.</p>
  </section>
</BaseLayout>
