---
/** Privacy — noindex. */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Privacy · Farflung Clues';
const description = 'Privacy practices of the Farflung Clues companion site.';
---

<BaseLayout title={title} description={description} path="/privacy/" robots="noindex, follow">
  <section class="hero">
    <h1>Privacy</h1>
    <p class="lede">Short version: this is a static site. We do not run accounts, analytics or advertising right now.</p>
  </section>
  <section class="block">
    <ul>
      <li><strong>No cookies.</strong> We set no tracking or preference cookies.</li>
      <li><strong>No analytics.</strong> No Google Analytics or similar third-party scripts are loaded.</li>
      <li><strong>Local countdowns.</strong> The reset countdown runs in your browser using your device clock; nothing is sent anywhere.</li>
      <li><strong>Hosting.</strong> Static files are served by our hosting provider, whose standard access logs apply to all websites.</li>
    </ul>
    <p>Questions? Open an issue on the site’s public repository.</p>
  </section>
</BaseLayout>
